# Public application URL (required in production)
UNMEET_PUBLIC_URL=https://app.example.com
UNMEET_HOST=0.0.0.0
UNMEET_PORT=8787
UNMEET_DB=/data/unmeet.db
NODE_ENV=production

# Set true for a private deployment where only invited accounts may join.
UNMEET_DISABLE_SIGNUP=false

# Stripe Billing: create recurring Prices for Starter and Team.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_TEAM=price_replace_me

# Transactional email through Resend. The sender domain must be verified.
RESEND_API_KEY=re_replace_me
UNMEET_FROM_EMAIL=UnMeet <team@example.com>
