# Public application URL (required in production)
UNMEET_PUBLIC_URL=https://app.example.com
UNMEET_HOST=0.0.0.0
UNMEET_PORT=8787
UNMEET_DB=/data/unmeet.db
NODE_ENV=production

# Set true for a private deployment where only invited accounts may join.
UNMEET_DISABLE_SIGNUP=false
UNMEET_TRUST_PROXY=true
# Maximum authentication attempts per client IP per 15-minute window.
UNMEET_AUTH_IP_LIMIT=50
UNMEET_ACCOUNT_WORKSPACE_LIMIT=5
UNMEET_PROVIDER_TIMEOUT_MS=15000

# 32 random bytes, base64 encoded. Required in production for OAuth token encryption.
# Generate once with: openssl rand -base64 32
UNMEET_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Read-only calendar connectors (optional; configure either or both).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Online payment remains disabled unless this explicit switch is enabled.
UNMEET_ENABLE_BILLING=false
# Stripe Billing (not required for this release).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_TEAM=price_replace_me

# Transactional email through Resend. The sender domain must be verified.
RESEND_API_KEY=re_replace_me
UNMEET_FROM_EMAIL=UnMeet <team@example.com>
